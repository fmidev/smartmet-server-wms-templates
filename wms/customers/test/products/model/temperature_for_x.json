      "layer_type": "map",
      "css": "maps/map.css",
      "map": {
        "lines": true,
        "schema": "esri",
        "table": "europe_country_wgs84",
        "minarea": 15
      },
      "attributes": {
        "class": "Border"
      }
    }]
  }]
 }
 