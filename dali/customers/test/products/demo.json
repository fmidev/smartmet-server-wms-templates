{
  "title": "Demo",
  "abstract": "Longer description",
  "width": 600,
  "height": 800,
  "refs": "json:products/map_product_refs.json",
  "defs": "json:products/common_defs.json",
  "projection": {
    "xsize": 600,
    "ysize": 800,
    "crs": "EPSG:4326",
    "x1": 18,
    "y1": 58,
    "x2": 33,
    "y2": 71
  },
  "views": [
    {
      "qid": "map_1",
      "attributes": {
        "transform": "translate(0 0)"
      },
      "layers": [
        {
          "qid": "precipitation_visualization_1",
          "producer": "gfs_world",
          "layer_type": "isoband",
          "parameter": "Precipitation1h",
          "isobands": "json:isobands/Precipitation.json",
          "css": "isobands/Precipitation.css",
          "attributes": {
            "shape-rendering": "crispEdges"
          }
        },
        {
          "qid": "precipitation_numbers_24h",
          "producer": "gfs_world",
          "layer_type": "number",
          "css": "numbers/numbers.css",
          "parameter": "sum_t(Precipitation1h:0h:24h)",
          "label": {
            "dx": 0,
            "dy": -8,
            "precision": 1,
            "missing": "-"
          },
          "positions": {
            "x": 40,
            "y": 40,
            "dx": 80,
            "dy": 80,
            "ddx": 40
          }
        },
        {
          "qid": "temperature_min_24h",
          "producer": "gfs_world",
          "layer_type": "number",
          "css": "numbers/numbers.css",
          "parameter": "min_t(Temperature:0h:24h)",
          "attributes": {
            "fill": "blue"
          },
          "label": {
            "dx": -12,
            "dy": 12,
            "precision": 0,
            "missing": "-"
          },
          "positions": {
            "x": 40,
            "y": 40,
            "dx": 80,
            "dy": 80,
            "ddx": 40
          }
        },
        {
          "qid": "temperature_max_24h",
          "producer": "gfs_world",
          "layer_type": "number",
          "css": "numbers/numbers.css",
          "parameter": "max_t(Temperature:0h:24h)",
          "attributes": {
            "fill": "red"
          },
          "label": {
            "dx": 12,
            "dy": 12,
            "precision": 0,
            "missing": "-"
          },
          "positions": {
            "x": 40,
            "y": 40,
            "dx": 80,
            "dy": 80,
            "ddx": 40
          }
        },
        {
          "qid": "city_weather_text",
          "producer": "gfs_world",
          "layer_type": "symbol",
          "parameter": "smartsymbol",
          "symbols": "json:symbols/smartweathertext.json",
          "scale": 1,
          "positions": {
            "layout": "latlon",
            "locations": [
              { "longitude": 24.941325, "latitude": 60.173437 },
              { "longitude": 23.761000, "latitude": 61.498000 },
              { "longitude": 22.270000, "latitude": 60.451000 },
              { "longitude": 25.473000, "latitude": 65.012000 },
              { "longitude": 25.722000, "latitude": 66.500000 },
              { "longitude": 25.747000, "latitude": 62.243000 },
              { "longitude": 27.678000, "latitude": 62.893000 },
              { "longitude": 29.763000, "latitude": 62.601000 }
            ],
            "dx": 0,
            "dy": 0
          }
        },
        "ref:refs.Europe_boundaries",
        {
          "qid": "weather_front",
          "layer_type": "wkt",
          "wkt": "LINESTRING(19 65.5, 22 66, 24.5 64.8, 23 64, 30 63.5)",
          "attributes": {
            "stroke": "red",
            "stroke-width": 3,
            "stroke-dasharray": "10,5",
            "fill": "none"
          }
        },
        {
          "qid": "lines",
          "layer_type": "tag",
          "tag": "g",
          "attributes": {
            "font-size": 50,
            "text-anchor": "middle"
          },
          "layers": [
            {
              "layer_type": "tag",
              "tag": "text",
              "cdata": "|",
              "attributes": {
                "x": 100,
                "y": 150
              }
            },
            {
              "layer_type": "tag",
              "tag": "text",
              "cdata": "|",
              "attributes": {
                "x": 250,
                "y": 300
              }
            },
            {
              "layer_type": "tag",
              "tag": "text",
              "cdata": "|",
              "attributes": {
                "x": 400,
                "y": 500
              }
            },
            {
              "layer_type": "tag",
              "tag": "text",
              "cdata": "|",
              "attributes": {
                "x": 150,
                "y": 650
              }
            }
          ]
        }
      ]
    }
  ]
}